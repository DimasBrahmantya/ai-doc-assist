# --- Gemini (server-side only) ---
GEMINI_API_KEY=
# Cek daftar model terbaru: https://ai.google.dev/gemini-api/docs/models
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Harus sama dengan vector(N) di migration
GEMINI_EMBEDDING_DIM=768

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Jangan pernah NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# --- App limits ---
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=200
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.35
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_HOUR=10
